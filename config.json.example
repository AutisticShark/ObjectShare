{
  "address": ":8080",
  "read_timeout": "5m",
  "write_timeout": "5m",
  "idle_timeout": "1m",
  "shutdown_timeout": "15s",
  "max_file_size": 100,
  "secure_cookies": false,
  "storage_service": "filesystem",
  "storage_path": "/var/lib/objectshare/objects",
  "db": {
    "type": "postgres",
    "host": "127.0.0.1",
    "port": 5432,
    "user": "objectshare",
    "password": "replace-me",
    "database": "objectshare",
    "ssl_mode": "require",
    "timezone": "UTC",
    "max_open_conns": 25,
    "max_idle_conns": 5,
    "conn_max_lifetime": "30m"
  },
  "encryption": {
    "enabled": false,
    "method": "aes-256-gcm",
    "key": ""
  },
  "r2": {
    "bucket_name": "",
    "account_id": "",
    "access_key_id": "",
    "secret_access_key": "",
    "region": "auto",
    "presign_link_timeout": "10m",
    "presign_upload_timeout": "1h"
  },
  "s3": {
    "bucket_name": "",
    "region": "us-east-1",
    "endpoint": "",
    "access_key_id": "",
    "secret_access_key": "",
    "session_token": "",
    "use_path_style": false,
    "presign_link_timeout": "10m",
    "presign_upload_timeout": "1h"
  },
  "b2": {
    "bucket_name": "",
    "region": "us-west-004",
    "endpoint": "",
    "access_key_id": "",
    "secret_access_key": "",
    "presign_link_timeout": "10m",
    "presign_upload_timeout": "1h"
  },
  "oss": {
    "bucket_name": "",
    "region": "cn-hangzhou",
    "endpoint": "",
    "access_key_id": "",
    "secret_access_key": "",
    "presign_link_timeout": "10m",
    "presign_upload_timeout": "1h"
  },
  "cos": {
    "bucket_name": "",
    "region": "ap-guangzhou",
    "endpoint": "",
    "access_key_id": "",
    "secret_access_key": "",
    "presign_link_timeout": "10m",
    "presign_upload_timeout": "1h"
  }
}
