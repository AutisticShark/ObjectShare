# Bootstrap settings are read on every start. Change these secrets before
# exposing the Compose stack beyond localhost and keep them stable.
POSTGRES_PASSWORD=replace-with-a-long-random-password
OBJECTSHARE_PORT=8080
OBJECTSHARE_JWT_SECRET=replace-with-at-least-32-random-bytes
OBJECTSHARE_SETTINGS_KEY=replace-with-a-different-32-byte-random-secret
OBJECTSHARE_JWT_LIFETIME=12h

# The remaining application settings are imported into PostgreSQL only when
# its configuration row does not yet exist. Afterwards use /admin/settings;
# changing these legacy seed values will not overwrite dashboard changes.
OBJECTSHARE_MAX_FILE_SIZE_MB=100
OBJECTSHARE_GUEST_UPLOAD_ENABLED=true
OBJECTSHARE_MAX_FILES_PER_BATCH=10
OBJECTSHARE_GUEST_RETENTION_DAYS=0
OBJECTSHARE_UNPAID_RETENTION_DAYS=0
OBJECTSHARE_SECURE_COOKIES=false
OBJECTSHARE_SIGNUP_ENABLED=true

# Optional billing and prepaid credit. One credit equals one whole unit of the
# selected supported two-decimal currency. Configure recurring plans at
# /admin/plans and register the documented webhook events for each gateway.
OBJECTSHARE_BILLING_PUBLIC_URL=http://localhost:8080
OBJECTSHARE_BILLING_CREDIT_CURRENCY=USD
OBJECTSHARE_BILLING_MIN_TOP_UP_CREDITS=5
OBJECTSHARE_BILLING_MAX_TOP_UP_CREDITS=1000

# Optional Stripe subscriptions and credit top-ups.
OBJECTSHARE_STRIPE_ENABLED=false
OBJECTSHARE_STRIPE_SECRET_KEY=
OBJECTSHARE_STRIPE_WEBHOOK_SECRET=

# Optional PayPal subscriptions and credit top-ups. Use sandbox while testing.
OBJECTSHARE_PAYPAL_ENABLED=false
OBJECTSHARE_PAYPAL_ENVIRONMENT=sandbox
OBJECTSHARE_PAYPAL_CLIENT_ID=
OBJECTSHARE_PAYPAL_CLIENT_SECRET=
OBJECTSHARE_PAYPAL_WEBHOOK_ID=

# Optional Cloudflare Turnstile. Set provider=turnstile, both keys, the exact
# public hostname, and all four protection switches for full coverage.
OBJECTSHARE_CAPTCHA_PROVIDER=none
OBJECTSHARE_CAPTCHA_SITE_KEY=
OBJECTSHARE_CAPTCHA_SECRET_KEY=
OBJECTSHARE_CAPTCHA_EXPECTED_HOSTNAME=
OBJECTSHARE_CAPTCHA_PROTECT_LOGIN=false
OBJECTSHARE_CAPTCHA_PROTECT_SIGNUP=false
OBJECTSHARE_CAPTCHA_PROTECT_UPLOAD=false
OBJECTSHARE_CAPTCHA_PROTECT_DOWNLOAD=false

# Shared PostgreSQL-backed fixed-window request limits. Zero disables a scope.
# Only list reverse-proxy CIDRs you operate; otherwise forwarded IPs are ignored.
OBJECTSHARE_RATE_LIMIT_ENABLED=true
OBJECTSHARE_RATE_LIMIT_WINDOW=1m
OBJECTSHARE_RATE_LIMIT_API=120
OBJECTSHARE_RATE_LIMIT_LOGIN=10
OBJECTSHARE_RATE_LIMIT_SIGNUP=5
OBJECTSHARE_RATE_LIMIT_UPLOAD=20
OBJECTSHARE_RATE_LIMIT_DOWNLOAD=60
OBJECTSHARE_TRUSTED_PROXY_CIDRS=

# Optional Google, GitHub, and Discord OAuth login. Use the browser-visible origin with
# no path. HTTPS is required except for localhost development.
OBJECTSHARE_PUBLIC_URL=http://localhost:8080
OBJECTSHARE_GOOGLE_OAUTH_ENABLED=false
OBJECTSHARE_GOOGLE_OAUTH_CLIENT_ID=
OBJECTSHARE_GOOGLE_OAUTH_CLIENT_SECRET=
OBJECTSHARE_GITHUB_OAUTH_ENABLED=false
OBJECTSHARE_GITHUB_OAUTH_CLIENT_ID=
OBJECTSHARE_GITHUB_OAUTH_CLIENT_SECRET=
OBJECTSHARE_DISCORD_OAUTH_ENABLED=false
OBJECTSHARE_DISCORD_OAUTH_CLIENT_ID=
OBJECTSHARE_DISCORD_OAUTH_CLIENT_SECRET=

# Optional server-side encryption. Generate with: openssl rand -base64 32
OBJECTSHARE_ENCRYPTION_ENABLED=false
OBJECTSHARE_ENCRYPTION_KEY=

# Optional Cloudflare R2 storage. Selecting R2 enables direct browser uploads.
OBJECTSHARE_STORAGE_SERVICE=filesystem
OBJECTSHARE_STORAGE_PATH=/var/lib/objectshare/objects
OBJECTSHARE_R2_BUCKET_NAME=
OBJECTSHARE_R2_ACCOUNT_ID=
OBJECTSHARE_R2_ACCESS_KEY_ID=
OBJECTSHARE_R2_SECRET_ACCESS_KEY=
OBJECTSHARE_R2_PRESIGN_TIMEOUT=10m
OBJECTSHARE_R2_UPLOAD_PRESIGN_TIMEOUT=1h

# Optional Amazon S3 storage. The AWS default credential chain is used when
# the two explicit key variables are empty.
OBJECTSHARE_S3_BUCKET_NAME=
OBJECTSHARE_S3_REGION=us-east-1
OBJECTSHARE_S3_ENDPOINT=
OBJECTSHARE_S3_ACCESS_KEY_ID=
OBJECTSHARE_S3_SECRET_ACCESS_KEY=
OBJECTSHARE_S3_SESSION_TOKEN=
OBJECTSHARE_S3_USE_PATH_STYLE=false
OBJECTSHARE_S3_PRESIGN_TIMEOUT=10m
OBJECTSHARE_S3_UPLOAD_PRESIGN_TIMEOUT=1h

# Optional Backblaze B2 S3-compatible storage.
OBJECTSHARE_B2_BUCKET_NAME=
OBJECTSHARE_B2_REGION=us-west-004
OBJECTSHARE_B2_ENDPOINT=
OBJECTSHARE_B2_ACCESS_KEY_ID=
OBJECTSHARE_B2_SECRET_ACCESS_KEY=
OBJECTSHARE_B2_PRESIGN_TIMEOUT=10m
OBJECTSHARE_B2_UPLOAD_PRESIGN_TIMEOUT=1h

# Optional Alibaba Cloud OSS S3-compatible storage.
OBJECTSHARE_OSS_BUCKET_NAME=
OBJECTSHARE_OSS_REGION=cn-hangzhou
OBJECTSHARE_OSS_ENDPOINT=
OBJECTSHARE_OSS_ACCESS_KEY_ID=
OBJECTSHARE_OSS_SECRET_ACCESS_KEY=
OBJECTSHARE_OSS_PRESIGN_TIMEOUT=10m
OBJECTSHARE_OSS_UPLOAD_PRESIGN_TIMEOUT=1h

# Optional Tencent Cloud COS S3-compatible storage. Include the APPID suffix
# in the bucket name, for example objectshare-1250000000.
OBJECTSHARE_COS_BUCKET_NAME=
OBJECTSHARE_COS_REGION=ap-guangzhou
OBJECTSHARE_COS_ENDPOINT=
OBJECTSHARE_COS_ACCESS_KEY_ID=
OBJECTSHARE_COS_SECRET_ACCESS_KEY=
OBJECTSHARE_COS_PRESIGN_TIMEOUT=10m
OBJECTSHARE_COS_UPLOAD_PRESIGN_TIMEOUT=1h
