# Change this before exposing the Compose stack beyond localhost.
POSTGRES_PASSWORD=replace-with-a-long-random-password
OBJECTSHARE_PORT=8080
OBJECTSHARE_MAX_FILE_SIZE_MB=100
OBJECTSHARE_SECURE_COOKIES=false

# Optional server-side encryption. Generate with: openssl rand -base64 32
OBJECTSHARE_ENCRYPTION_ENABLED=false
OBJECTSHARE_ENCRYPTION_KEY=

# Optional Cloudflare R2 storage. Selecting R2 enables direct browser uploads.
OBJECTSHARE_STORAGE_SERVICE=filesystem
OBJECTSHARE_STORAGE_PATH=/var/lib/objectshare/objects
OBJECTSHARE_R2_BUCKET_NAME=
OBJECTSHARE_R2_ACCOUNT_ID=
OBJECTSHARE_R2_ACCESS_KEY_ID=
OBJECTSHARE_R2_SECRET_ACCESS_KEY=
OBJECTSHARE_R2_PRESIGN_TIMEOUT=10m
OBJECTSHARE_R2_UPLOAD_PRESIGN_TIMEOUT=1h
